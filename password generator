import secrets
import string


def generate_password(
    length: int = 16,
    use_uppercase: bool = True,
    use_lowercase: bool = True,
    use_digits: bool = True,
    use_symbols: bool = True,
) -> str:
    """Generates a secure, random password with custom character requirements."""
    character_pools = []
    guaranteed_chars = []

    if use_uppercase:
        character_pools.append(string.ascii_uppercase)
        guaranteed_chars.append(secrets.choice(string.ascii_uppercase))
    if use_lowercase:
        character_pools.append(string.ascii_lowercase)
        guaranteed_chars.append(secrets.choice(string.ascii_lowercase))
    if use_digits:
        character_pools.append(string.digits)
        guaranteed_chars.append(secrets.choice(string.digits))
    if use_symbols:
        symbols = "!@#$%^&*()_+-=[]{}|;:,.<>?"
        character_pools.append(symbols)
        guaranteed_chars.append(secrets.choice(symbols))

    if not character_pools:
        raise ValueError("At least one character type must be selected.")

    if length < len(guaranteed_chars):
        raise ValueError(
            f"Password length must be at least {len(guaranteed_chars)} to meet requirements."
        )

    # Combine all selected character sets
    all_characters = "".join(character_pools)

    # Fill remaining password length
    remaining_length = length - len(guaranteed_chars)
    remaining_chars = [
        secrets.choice(all_characters) for _ in range(remaining_length)
    ]

    # Combine and shuffle to prevent predictable character positioning
    password_list = guaranteed_chars + remaining_chars
    secrets.SystemRandom().shuffle(password_list)

    return "".join(password_list)


# --- Example Usage ---
if __name__ == "__main__":
    # Standard 16-character password
    password = generate_password(length=16)
    print(f"Generated Password: {password}")

    # Custom options (e.g., 20 chars, no symbols)
    alphanumeric_password = generate_password(
        length=20, use_symbols=False
    )
